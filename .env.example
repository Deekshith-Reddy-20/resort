# Copy to apps/web/.env.local for local development.
# Never commit real secrets. Never put service-role or Razorpay secrets in the Android app.

# --- Public site ---
# Local: http://localhost:3000
# Vercel Preview: set after the first deploy to https://<deployment>.vercel.app (no trailing slash).
# Until then the app uses VERCEL_URL automatically (server-side only).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only ---
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_MODE=memory
# DATABASE_MODE=supabase when credentials are configured

# Asia/Kolkata is the property timezone. Do not change without owner approval.
PROPERTY_TIMEZONE=Asia/Kolkata
PROPERTY_ID=vfarms-hyderabad

# Booking remains disabled until a complete stay configuration is published in admin.
BOOKING_ENABLED=false
HOLD_MINUTES=15

# Optional local-only bootstrap. Never set these in production.
# When DEV_STAY_CONFIG_PUBLISH=true and every field is valid, memory mode publishes that snapshot on boot.
# DEV_STAY_CONFIG_PUBLISH=false
# DEV_WEEKDAY_INR=
# DEV_WEEKEND_INR=
# DEV_TAX_BPS=
# DEV_DEPOSIT_BPS=
# DEV_MAX_GUESTS=
# DEV_MIN_NIGHTS=
# DEV_MAX_NIGHTS=
# DEV_CHECK_IN=
# DEV_CHECK_OUT=
# DEV_CANCELLATION=
# DEV_TERMS_CONFIRMED=false
# DEV_PRIVACY_CONFIRMED=false

# --- Razorpay (test mode by default). Leave empty to keep payments NOT CONFIGURED. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_LIVE_MODE=false

# --- Email (optional). Booking still works if unset; delivery is NOT TESTED. ---
RESEND_API_KEY=
EMAIL_FROM=
NOTIFY_OWNER_EMAIL=

# --- Admin ---
# Generate STAFF_SESSION_SECRET with: openssl rand -hex 32
# Hosted (Vercel): HMAC staff cookie + Supabase Auth + admin_profiles. Never set STAFF_DEV_* there.
STAFF_SESSION_SECRET=
# Local development password login only. Ignored on Vercel and when NODE_ENV=production.
STAFF_ALLOW_DEV_PASSWORD=true
STAFF_DEV_EMAIL=
STAFF_DEV_PASSWORD=

# Never set DEV_STAY_CONFIG_PUBLISH=true on Vercel.

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
